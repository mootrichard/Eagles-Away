APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
ADDITIONAL_FRONTEND_ORIGINS=
PREVIEW_ACCESS_REQUIRED=true
PREVIEW_USERNAME=
PREVIEW_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cpfc:cpfc@localhost:5432/cpfc
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cpfc-trip-v3
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
WORKER_BUILD_ID=
PLANNER_MODE=recorded
SEARCHAPI_API_KEY=
SEARCHAPI_ENABLED=true
# Reuse stored live search results for this long (one day). Set 0 to force every
# search to call SearchApi. Production uses its own values.
SEARCH_CACHE_TTL_MINUTES=1440
# If SearchApi fails, serve a cached result up to this much past its TTL (marked as older).
SEARCH_CACHE_STALE_IF_ERROR_MINUTES=1440
# Refresh popular or slow searches early: on average beta x the search's own duration
# before the TTL (240 x a 15 s search ≈ 1 hour). 0 disables early refresh.
SEARCH_CACHE_EARLY_BETA=240
